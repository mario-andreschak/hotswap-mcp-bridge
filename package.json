{
  "name": "mcp-transport-bridge",
  "version": "0.2.0",
  "description": "Authenticated MCP HTTP, SSE and stdio bridge with atomic environment swaps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-transport-bridge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:package": "npm run build && node scripts/package-acceptance.mjs",
    "test:docker": "node scripts/docker-acceptance.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "bridge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/server-legacy": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
